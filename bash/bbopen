#!/usr/bin/env bash
#
# Opens a file in the Bitbucket Server web UI, on the current branch, in your
# browser.
# Prefers the upstream remote and falls back to origin, so it points at the
# canonical repo rather than a personal fork.
#
#   bbopen poc/scripts/dbx_sync_test.py 32   # file, at line 32
#   bbopen poc/scripts                       # a directory
#   bbopen                                   # repo root
#
# BBOPEN_BRANCH=develop and BBOPEN_REMOTE=origin override the defaults.

set -euo pipefail

# shellcheck source=bb-lib.sh
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/bb-lib.sh"

file="${1:-}"
line="${2:-}"

root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "bbopen: not in a git repo" >&2
  exit 1
}

branch="${BBOPEN_BRANCH:-$(git branch --show-current)}"
[[ -n "$branch" ]] || {
  echo "bbopen: HEAD is detached; set BBOPEN_BRANCH to the branch to open" >&2
  exit 1
}

preferred="${BBOPEN_REMOTE:-upstream}"
remote="$(bb_remote_for_branch "$branch" "$preferred" origin || true)"
url="$(bb_remote_url "${remote:-$preferred}" origin)" || {
  echo "bbopen: no $preferred or origin remote" >&2
  exit 1
}
bb_parse_remote "$url"
base="$BB_WEB_BASE"

rel=""
if [[ -n "$file" ]]; then
  if [[ -d "$file" ]]; then
    abs="$(cd -- "$file" && pwd -P)"
    rel="${abs#"$root"}"
    rel="${rel#/}"
  else
    # ls-files resolves the path from any cwd, but only for tracked files
    rel="$(git ls-files --full-name -- "$file" 2>/dev/null | head -1 || true)"
    if [[ -z "$rel" && -e "$file" ]]; then
      abs="$(cd -- "$(dirname -- "$file")" && pwd -P)/$(basename -- "$file")"
      rel="${abs#"$root"}"
      rel="${rel#/}"
    fi
    # otherwise it isn't on disk, so assume it is already repo-relative
    [[ -n "$rel" ]] || rel="$file"
  fi
  rel="${rel// /%20}"
fi

target="$base/browse"
[[ -z "$rel" ]] || target="$target/$rel"
target="$target?at=refs%2Fheads%2F$branch"
[[ -z "$line" ]] || target="$target#$line"

printf '%s\n' "$target"
open "$target"
